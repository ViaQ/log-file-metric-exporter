FROM registry.redhat.io/openshift/golang-builder:golang-builder-v1.26-rhel9 AS builder

ENV GOEXPERIMENT=strictfipsruntime
ENV CGO_ENABLED=1

COPY . /opt/app-root/src
WORKDIR /opt/app-root/src

RUN make build LDFLAGS="-tags strictfipsruntime -ldflags '-s -w'"

# Stage the OpenSSL backend required by the strictfipsruntime build into a
# staging root, the same way vector-rhel9 provisions its ubi-micro runtime
# image. Without these libraries the binary aborts at startup on FIPS-enabled
# nodes with:
#   "FIPS mode is enabled, but the required OpenSSL backend is unavailable"
# (ubi-micro itself ships no OpenSSL.)
FROM registry.access.redhat.com/ubi9/ubi AS packages

RUN mkdir -p /mnt/rootfs && \
    dnf install -y --installroot=/mnt/rootfs \
      --releasever=9 \
      --setopt=install_weak_deps=false \
      --nodocs \
      openssl-libs \
      ca-certificates && \
    dnf --installroot=/mnt/rootfs clean all

FROM registry.access.redhat.com/ubi9/ubi-micro

COPY --from=packages /mnt/rootfs/ /
COPY --from=builder /opt/app-root/src/bin/log-file-metric-exporter  /usr/local/bin/.

RUN chmod +x /usr/local/bin/log-file-metric-exporter

USER 65532:0

CMD ["/usr/local/bin/log-file-metric-exporter", "-verbosity=2", "-dir=/var/log/pods", "-http=:2112"]

LABEL \
        com.redhat.component="log-file-metric-exporter-container" \
        description="OpenShift LogFileMetric Exporter component of OpenShift Cluster Logging" \
        distribution-scope="subscription" \
        io.k8s.description="OpenShift LogFileMetric Exporter component of OpenShift Cluster Logging" \
        io.k8s.display-name="OpenShift LogFileMetric Exporter" \
        io.openshift.maintainer.component="Logging" \
        io.openshift.maintainer.product="OpenShift Container Platform" \
        io.openshift.tags="logging,eventrouter,observability" \
        license="Apache-2.0" \
        maintainer="AOS Logging <team-logging@redhat.com>" \
        name="openshift-logging/log-file-metric-exporter-rhel9" \
        summary="Container log file metrics agent for Red Hat Openshift Logging" \
        url="https://catalog.redhat.com/en/software/containers/openshift-logging/log-file-metric-exporter-rhel9/6447991f3270b32a256c4e2a" \
        vendor="Red Hat, Inc." \
        version_minor="v1.1" \
        version="v1.1.0"
